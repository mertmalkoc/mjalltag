rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gemeinsame Daten: nur die zwei freigeschalteten E-Mail-Adressen
    match /shared/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['EMAIL_1@BEISPIEL.DE', 'EMAIL_2@BEISPIEL.DE'];
    }
    // Private Daten (Kalorien, Einstellungen): nur der Besitzer selbst
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
